  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const requestName = pm.info.requestName;\r",
          "\r",
          "if (requestName.includes(\"Admin\") || requestName.includes(\"nominal\")) {\r",
          "    pm.environment.set(\"token\", pm.environment.get(\"token_admin\"));\r",
          "} else if (requestName.includes(\"Client\")) {\r",
          "    pm.environment.set(\"token\", pm.environment.get(\"token_client\"));\r",
          "} else if (requestName.includes(\"Consultante\")) {\r",
          "    pm.environment.set(\"token\", pm.environment.get(\"token_consultante\"));\r",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "",
          "const status = pm.response.code;",
          "const requestName = pm.info.requestName;",
          "",
          "// Les erreurs 4xx ne sont acceptées que pour les tests",
          "// dont le nom indique explicitement un accès refusé ou une erreur attendue.",
          "const expectedError =",
          "    /Access denied|No Auth|Forbidden|Unauthorized|Invalid|Missing|Not Found/i.test(requestName)",
          "    || requestName.includes(\"Copy\");",
          "",
          "pm.test(\"Status code is expected\", function () {",
          "    if (expectedError) {",
          "        pm.expect(status).to.be.within(400, 499);",
          "    } else {",
          "        pm.expect(status).to.be.within(200, 299);",
          "    }",
          "});",
          "",
          "pm.test(\"Response time < 5000ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test(\"Response is JSON when body exists\", function () {",
          "    if (pm.response.text()) {",
          "        pm.response.to.be.json;",
          "    }",
          "});",
          ""
        ]
      }
    }
  ]
